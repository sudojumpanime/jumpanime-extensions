{
  "apiVersion": 1,
  "type": "manga",
  "id": "en.aquamanga",
  "name": "Aqua Manga",
  "version": "1.2.0",
  "description": "Manga, manhwa and manhua in English.",
  "author": "JumpAnime",
  "baseUrl": "https://aquareader.org",
  "iconUrl": "https://www.google.com/s2/favicons?domain=aquareader.org&sz=128",
  "engine": "madara",
  "options": {
    "popularUrl": "{base}/manga/page/{p}/?m_orderby=views",
    "latestUrl": "{base}/manga/page/{p}/?m_orderby=latest",
    "searchUrl": "{base}/manga/page/{p}/?search={q}",
    "listItem": ".aqua-manga-card",
    "listLink": ".aqua-manga-card__title a",
    "listCover": "img",
    "nextPage": "a.next",
    "titleItem": ".aqua-series-info__title",
    "coverItem": ".aqua-series-cover__img",
    "descItem": ".aqua-series-synopsis",
    "genreItem": ".aqua-series-genre-pill",
    "chapterItem": ".aqua-ch-item",
    "chapterLink": "a",
    "chapterName": ".aqua-ch-item__name",
    "chaptersAjax": "false",
    "authorItem": ".aqua-series-info__creator-value a",
    "statusItem": ".aqua-series-meta__status",
    "pageItem": "div.page-break img, .reading-content img"
  }
}
